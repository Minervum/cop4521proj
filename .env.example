# Bot D - Esports Trading Bot Configuration

# Database path (shared across all bots)
BOT_DB_PATH=data/botd.db

# Kalshi API credentials (for live trading)
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_ENV=demo  # demo or prod

# Paper trading mode (true = never place real orders)
PAPER_TRADING=true

# Starting bankroll for paper trader (in USD)
PAPER_BANKROLL=10000.0

# Half-Kelly fraction (0.5 = half-Kelly)
KELLY_FRACTION=0.5

# Max position size as fraction of bankroll
MAX_POSITION_FRACTION=0.10

# Minimum edge required to place a bet (0.05 = 5%)
MIN_EDGE=0.05

# Data refresh intervals (seconds)
HLTV_REFRESH_INTERVAL=3600
VLR_REFRESH_INTERVAL=3600
LIQUIPEDIA_REFRESH_INTERVAL=900

# Rate limiting delays (seconds between requests)
HLTV_REQUEST_DELAY=3.0
VLR_REQUEST_DELAY=2.0
LIQUIPEDIA_REQUEST_DELAY=2.0

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001
